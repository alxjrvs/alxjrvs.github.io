---
// Every page: the floating header, back-to-top button and,
// away from the home page, the footer.
import chromeSrc from "../client/chrome.ts?inline-script";
import dieSrc from "../client/die.ts?inline-script";
import fabSrc from "../client/fab.ts?inline-script";
import jsFlagSrc from "../client/js-flag.ts?inline-script";
import Die from "../components/Die.astro";
import Footer from "../components/Footer.astro";
import InlineScript from "../components/InlineScript.astro";
import Seo, { type SeoImage } from "../components/Seo.astro";
import Wordmark from "../components/Wordmark.astro";
import { getNav, getRolls, getSiteText } from "../lib/content";
import { site } from "../site";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  published?: Date | undefined;
  /** a reading-progress line under the header (pieces of writing) */
  progress?: boolean | undefined;
  /** the share card, if not the site's own (a comic's first page) */
  image?: SeoImage | undefined;
  /** more schema.org for the page (see Seo.astro) */
  ld?: Record<string, unknown> | undefined;
  noindex?: boolean | undefined;
  /** on phones, once a piece's title fills the header, its controls wait in a
      floating menu (client/fab.ts): the nav, the die, Back and Next */
  menu?: { prev?: Step | undefined; next?: Step | undefined } | undefined;
}
interface Step {
  href: string;
  /** where it goes ("Part 1: Title") */
  title: string;
}

const isHome = Astro.url.pathname === "/";
// Away from the home page, the nav link for the page's own section is current.
const section = Astro.url.pathname.startsWith("/writing") ? "/#writing" : undefined;
const { progress, menu, ...seo } = Astro.props;
const [nav, rolls, text] = await Promise.all([getNav(Astro), getRolls(Astro), getSiteText(Astro)]);
const { subjects, objects, likes } = rolls;
const rollData = JSON.stringify({ subjects, objects, rare: rolls.rare, rareOdds: rolls.rareOdds, likes }).replace(
  /</g,
  "\\u003c",
);
// changes on every build (astro.config.ts), so a deploy's CSS is never served
// from a stale cache, and stays put between builds so browsers can keep it
const v = __BUILD_ID__;
---
<!doctype html>
<html lang={site.lang}>
<head>
  <meta charset="utf-8">
  <Fragment set:html={"<!--\n\n  I CAN SEE YOU.\n\n  Reading the source? Same. This page is Astro on a Cloudflare Worker, the\n  words come from EmDash, and the whole thing is open:\n  https://github.com/alxjrvs/alxjrvs.github.io\n\n  There's a die in the console too. Try roll().\n\n-->"} />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#14161f">
  <InlineScript src={jsFlagSrc} name="js-flag.ts" />

  <link rel="icon" href={`/assets/favicon.svg?v=${v}`} type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/familjen-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href={`/assets/css/site.css?v=${v}`}>
  <link type="application/atom+xml" rel="alternate" href={`${site.url}/feed.xml`} title={text.title}>
  <Seo {...seo} site={text} />
  {/* fetch a link's page as soon as the pointer settles on it (Chromium) */}
  <script is:inline type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { and: [{ href_matches: "/*" }, { not: { href_matches: "/_*" } }] }, eagerness: "moderate" }] })} />
</head>
<body class={isHome ? "home" : "inner"}>
  <a class="skip" href="#main">Skip to content</a>

  {/*
    The floating header. On the home page it starts hidden and slides in as
    you scroll, while the big wordmark shrinks into the brand slot (see
    src/client/recede.ts). Everywhere else it's simply there.
  */}
  <header class="bar" id="bar">
    <div class="bar-id">
      <a class="brand" href="/"><Wordmark /></a>
      <p class="bar-tag" aria-hidden="true"><span class="tag-a"><span class="roll-subject" data-suffix=".">{rolls.subjects[0]}.</span></span> <span class="tag-b">{rolls.lead} <em class="roll-object" data-suffix=".">{rolls.objects[0]}.</em></span></p>
    </div>
    {/* a piece's title and its Back/Next, once the title has docked (client/title.ts) */}
    <slot name="bar" />
    <nav class="nav" aria-label="Primary">
      {nav.map((item) => <a href={isHome || item.url !== section ? item.url : "/writing/"} aria-current={item.url === section ? "page" : undefined}>{item.name}</a>)}
      <Die class="die-bar" label={isHome ? undefined : "Roll the die: new tagline"} />
    </nav>
    {progress && <span class="read-progress" id="read-progress" aria-hidden="true"></span>}
  </header>

  <main id="main">
    <slot />
  </main>

  {!isHome && <Footer class="foot wrap" />}

  {menu && (
    <div class="fab" id="fab">
      <div class="fab-panel" id="fab-panel" hidden>
        <a class="brand" href="/"><Wordmark /></a>
        <nav class="fab-nav" aria-label="Primary, in the menu">
          {nav.map((item) => <a href={item.url === section ? "/writing/" : item.url}>{item.name}</a>)}
        </nav>
        <div class="fab-row">
          {[
            { to: menu.prev, text: "Back", rel: "prev", arrow: "←" },
            { to: menu.next, text: "Next", rel: "next", arrow: "→" },
          ].map(({ to, text, rel, arrow }) => to ? (
            <a class="fab-key" href={to.href} rel={rel} title={to.title}><span aria-hidden="true">{arrow}</span><span class="sr">{text}: {to.title}</span></a>
          ) : (
            <span class="fab-key" aria-disabled="true"><span aria-hidden="true">{arrow}</span><span class="sr">{text}</span></span>
          ))}
          <Die class="fab-key die-fab" label="Roll the die" />
          <a class="fab-key fab-top" href="#main"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"/></svg><span class="sr">Back to top</span></a>
        </div>
      </div>
      <button class="fab-btn" type="button" aria-expanded="false" aria-controls="fab-panel" aria-label="Menu"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="4.5" cy="4.5" r="1.6"/><circle cx="11.5" cy="4.5" r="1.6"/><circle cx="4.5" cy="11.5" r="1.6"/><circle cx="11.5" cy="11.5" r="1.6"/></svg></button>
    </div>
  )}

  <a class="to-top" id="to-top" href="#main" aria-label="Back to top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"/></svg></a>

  <InlineScript src={chromeSrc} name="chrome.ts" />
  {/* The die rolls the header tagline on every page (and, at home, the
      splash, the project cards and About too). */}
  <script is:inline type="application/json" id="roll-data" set:html={rollData} />
  {/* says what the die landed on, for screen readers */}
  <p class="sr" role="status" id="die-status"></p>
  <InlineScript src={dieSrc} name="die.ts" />
  {menu && <InlineScript src={fabSrc} name="fab.ts" />}
  <slot name="scripts" />
  {site.analyticsToken && (
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analyticsToken })} />
  )}
</body>
</html>
