---
// Renders a TypeScript file from src/client/ as a classic inline <script>,
// exactly where it's placed. Inline and synchronous on purpose: the theme has
// to be set before first paint, and the splash has to be measured before the
// first frame, which a deferred module script (Astro's default) can't promise.
// The source stays real TypeScript, so it's type-checked and linted; it's
// compiled to JavaScript at build time by the `?inline-script` import
// (inlineScripts() in astro.config.ts), since pages now render in the Worker.

interface Props {
  /** the compiled file, imported with `?inline-script` */
  src: string;
  /** its name, for error messages */
  name: string;
}

const { src } = Astro.props;
---
<script is:inline set:html={src} />
