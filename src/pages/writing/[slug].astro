---
import { decodeSlug } from "emdash";
import Comic from "../../components/Comic.astro";
import Prose from "../../components/Prose.astro";
import Stepper from "../../components/Stepper.astro";
import Tags from "../../components/Tags.astro";
import ThreadParts from "../../components/ThreadParts.astro";
import progressSrc from "../../client/progress.ts?inline-script";
import stepperSrc from "../../client/stepper.ts?inline-script";
import titleSrc from "../../client/title.ts?inline-script";
import InlineScript from "../../components/InlineScript.astro";
import Base from "../../layouts/Base.astro";
import { getPlace, getPosts, getProjects, longDate, measure, type Post, shortDate, year } from "../../lib/content";

// One piece of writing, rendered on request from the published posts in
// EmDash (newest first, so the next one along is older). Unknown or
// unpublished slugs get the 404. The details sit in the left-hand margin
// (any credits first, role by role), the words in a 40rem column beside it.
// A piece in a thread also gets "Part 2 of 3" and the thread's description
// (in italics) above its title, the thread's parts in the margin, and a pager
// that walks the thread instead of the archive. A comic shows its pages in place
// of the words, one at a time, with any words underneath as a note: its title
// and the page in view fill one screen, with nothing to scroll (.comic-screen).
const slug = decodeSlug(Astro.params.slug);
const posts = await getPosts(Astro);
const i = posts.findIndex((p) => p.id === slug);
const post = posts[i];
if (!post) return Astro.rewrite("/404");
const older = posts[i + 1];
const newer = posts[i - 1];
const proj = post.project
  ? (await getProjects(Astro)).find((p) => p.id === post.project)
  : undefined;
const comic = post.pages.length > 0;
const hasWords = Array.isArray(post.content) && post.content.length > 0;
const place = await getPlace(Astro, post);
const total = place?.thread.parts.length ?? 0;
const threadUrl = place && `/writing/threads/${place.thread.slug}/`;
// Going back into a comic lands on its last page, like turning back a page.
const back = (p: Post) => `/writing/${p.id}/${p.pages.length > 1 ? `#page-${p.pages.length}` : ""}`;
const when = (d: Date) => `${shortDate(d)}, ${year(d)}`;
// The title, word by word, twice: the big one and the header's one-line copy.
// As you scroll, each word of the big one travels to its twin in the header
// (client/title.ts), the way the splash's tagline does at home.
const words = post.title.split(/\s+/).filter(Boolean);
// The header's Back and Next: the thread's parts, or else the pieces either
// side by date (newer on the left, like the pager under the words).
const barPrev = place
  ? place.prev && { href: back(place.prev), title: `Part ${place.n - 1}: ${place.prev.title}` }
  : newer && { href: `/writing/${newer.id}/`, title: `Newer: ${newer.title}` };
const barNext = place
  ? place.next && { href: `/writing/${place.next.id}/`, title: `Part ${place.n + 1}: ${place.next.title}` }
  : older && { href: `/writing/${older.id}/`, title: `Older: ${older.title}` };
---
<Base title={post.title} description={post.description} published={post.date} progress>
<Stepper slot="bar" class="bar-read" label={place ? "Parts, in the header" : "More writing, in the header"} compact prev={barPrev} next={barNext}>
  <span class="bar-title" aria-hidden="true">{words.map((w, i) => <>{i > 0 && " "}<span class="w">{w}</span></>)}</span>
</Stepper>
<article class:list={["post wrap ruled", { "is-comic": comic }]} style={proj && `--accent:${proj.accent_dark}`}>
  <aside class="margin post-margin">
    <a class="crumb label" href="/writing/"><span aria-hidden="true">←</span> Writing</a>
    <dl class="facts">
      {post.credits.map((c) => (
        <div class="credit"><dt class="label">{c.role}</dt><dd>{c.link ? <a href={c.link}>{c.name} <span aria-hidden="true">↗</span></a> : c.name}</dd></div>
      ))}
      <div><dt class="label">Published</dt><dd><time datetime={post.date.toISOString()}>{longDate(post.date)}</time></dd></div>
      <div><dt class="label">{comic ? "Comic" : "Reading"}</dt><dd>{measure(post)}</dd></div>
      {proj && <div><dt class="label">Project</dt><dd><a class="tag" href={proj.link}>{proj.title} <span aria-hidden="true">↗</span></a></dd></div>}
      {place && (
        <div class="thread-fact">
          <dt class="label">Thread</dt>
          <dd>
            <a class="thread-name" href={threadUrl}>{place.thread.label}</a>
            <span class="of">Part {place.n} of {total}</span>
            <ThreadParts parts={place.thread.parts} current={post.id} class="margin-parts" />
          </dd>
        </div>
      )}
      {post.tags.length > 0 && <div><dt class="label">Tags</dt><dd><Tags tags={post.tags} /></dd></div>}
    </dl>
  </aside>

  <div class="post-body" id="read">
    <div class:list={{ "comic-screen": comic }}>
    <header class="post-head">
      {place && (
        <Stepper
          class="part-bar"
          label="This thread"
          noun="Part"
          n={place.n}
          total={total}
          name={{ href: threadUrl ?? "", title: place.thread.label }}
          prev={place.prev && { href: back(place.prev), title: `Part ${place.n - 1}: ${place.prev.title}` }}
          next={place.next && { href: `/writing/${place.next.id}/`, title: `Part ${place.n + 1}: ${place.next.title}` }}
          keys={!comic}
        />
      )}
      {place?.thread.description && <p class="thread-about">{place.thread.description}</p>}
      <h1>{words.map((w, i) => <>{i > 0 && " "}<span class="w">{w}</span></>)}</h1>
      {post.description && <p class="dek">{post.description}</p>}
    </header>

    {comic && (
      <Comic
        pages={post.pages}
        title={post.title}
        beyond={place && { prev: place.prev && back(place.prev), next: place.next && `/writing/${place.next.id}/` }}
      />
    )}
    </div>
    {(!comic || hasWords) && (
      <div class:list={["prose", { "comic-note": comic }]}>
        <Prose value={post.content} />
      </div>
    )}
    <p class="fin" aria-hidden="true"><span class="pip"></span></p>

    {place ? (
      <>
        <nav class="pager" aria-label="This thread">
          {place.prev ? (
            <a class="next" href={back(place.prev)} rel="prev"><span class="label"><span aria-hidden="true">←</span> Part {place.n - 1}</span><span class="t">{place.prev.title}</span></a>
          ) : <span />}
          {place.next ? (
            <a class="prev" href={`/writing/${place.next.id}/`} rel="next"><span class="label">Part {place.n + 1} <span aria-hidden="true">→</span></span><span class="t">{place.next.title}</span></a>
          ) : (
            <a class="prev" href="/writing/"><span class="label">End of the thread</span><span class="t">More writing <span aria-hidden="true">→</span></span></a>
          )}
        </nav>
        <section class="thread-end" aria-labelledby="thread-end">
          <h2 class="label" id="thread-end"><a href={threadUrl}>{place.thread.label}</a> · {total} {total === 1 ? "part" : "parts"}</h2>
          <ThreadParts parts={place.thread.parts} current={post.id} />
        </section>
      </>
    ) : (older || newer) ? (
      <nav class="pager" aria-label="More writing">
        {newer ? (
          <a class="next" href={`/writing/${newer.id}/`}><span class="label"><span aria-hidden="true">←</span> Newer · {when(newer.date)}</span><span class="t">{newer.title}</span></a>
        ) : <span />}
        {older ? (
          <a class="prev" href={`/writing/${older.id}/`}><span class="label">Older · {when(older.date)} <span aria-hidden="true">→</span></span><span class="t">{older.title}</span></a>
        ) : <span />}
      </nav>
    ) : null}
  </div>
</article>
{!comic && <InlineScript slot="scripts" src={progressSrc} name="progress.ts" />}
{(comic || place) && <InlineScript slot="scripts" src={stepperSrc} name="stepper.ts" />}
<InlineScript slot="scripts" src={titleSrc} name="title.ts" />
</Base>
