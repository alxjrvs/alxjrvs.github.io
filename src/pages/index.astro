---
import carouselSrc from "../client/carousel.ts?inline-script";
import dieSrc from "../client/die.ts?inline-script";
import gridSrc from "../client/grid.ts?inline-script";
import recedeSrc from "../client/recede.ts?inline-script";
import snapSrc from "../client/snap.ts?inline-script";
import Die from "../components/Die.astro";
import Footer from "../components/Footer.astro";
import InlineScript from "../components/InlineScript.astro";
import PostList from "../components/PostList.astro";
import Prose from "../components/Prose.astro";
import Base from "../layouts/Base.astro";
import { getPosts, getProjects, getRolls, getSection } from "../lib/content";

const [projects, posts, rolls, projectsHead, writingHead, about] = await Promise.all([
  getProjects(Astro),
  getPosts(Astro),
  getRolls(Astro),
  getSection(Astro, "projects"),
  getSection(Astro, "writing"),
  getSection(Astro, "about"),
]);
const { subjects, objects, lead, likes, likesLead } = rolls;
const rollData = JSON.stringify({ subjects, objects, rare: rolls.rare, rareOdds: rolls.rareOdds, likes }).replace(
  /</g,
  "\\u003c",
);
---
<Base>
<section class="screen intro" aria-label="Introduction">
  <Die class="die-corner" />
  <h1 class="mark" id="mark" aria-label="alex jarvis"><span class="alx">al<span class="ghost">e</span>x</span><span class="ghost">&nbsp;</span><span class="jrvs">j<span class="ghost">a</span>rv<span class="ghost">i</span>s</span></h1>
  <p class="tagline" id="tagline"><span class="tag-a"><span class="roll roll-subject" data-suffix=".">{subjects[0]}.</span></span> <span class="tag-b">{lead} <em class="roll roll-object" data-suffix=".">{objects[0]}.</em></span></p>
  <a class="scroll-cue" href="#projects" aria-label="Scroll to projects"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9.5l6 6 6-6"/></svg></a>
</section>

<section class="screen wrap" id="projects" aria-labelledby="projects-head">
  <h2 id="projects-head">{projectsHead?.title}</h2>
  <div class="carousel">
  <div class="cards" id="cards">
    {projects.map((p) => {
      const shot = p.shot && `/assets/work/${p.shot}`;
      return (
        <article class="card" style={`--accent-light:${p.accent};--accent-dark:${p.accent_dark}`}>
          {shot && <a class="shot" href={p.link} tabindex="-1" aria-hidden="true"><img src={`${shot}.webp`} srcset={`${shot}-640.webp 640w, ${shot}.webp 1280w`} sizes="(max-width: 760px) 84vw, 60vw" alt="" width="1280" height="800" loading="lazy" decoding="async"></a>}
          <div class="card-body">
            <h3>{p.title}</h3>
            <p class="summary">{p.summary}</p>
            <a class="visit" href={p.link}>Visit {p.link_label ?? p.title} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      );
    })}
  </div>
  <button class="nudge next" type="button" aria-label="Next project" aria-controls="cards"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6l6 6-6 6"/></svg></button>
  </div>
</section>

{/* Writing only exists on the page (and in the nav) once there's some. */}
{posts.length > 0 && (
  <section class="screen wrap" id="writing" aria-labelledby="writing-head">
    <div class="section-head">
      <h2 id="writing-head">{writingHead?.title}</h2>
      {writingHead?.dek && <a href="/writing/">{writingHead.dek} <span aria-hidden="true">→</span></a>}
    </div>
    <PostList posts={posts.slice(0, 5)} />
  </section>
)}

<section class="screen wrap about" id="about" aria-labelledby="about-head">
  <div class="about-body">
    <h2 id="about-head">{about?.title}</h2>
    <div class="bio">
      {about && <Prose value={about.body} />}
      <p class="likes">{likesLead} <span id="likes"><span class="like">{likes[0][0]}</span>, <span class="like">{likes[1][0]}</span>, and <span class="like">{likes[2][0]}</span></span>.</p>
    </div>
  </div>
  <Footer class="foot" />
</section>

<Fragment slot="scripts">
  <script is:inline type="application/json" id="roll-data" set:html={rollData} />
  <InlineScript src={dieSrc} name="die.ts" />
  <InlineScript src={gridSrc} name="grid.ts" />
  <InlineScript src={carouselSrc} name="carousel.ts" />
  <InlineScript src={recedeSrc} name="recede.ts" />
  <InlineScript src={snapSrc} name="snap.ts" />
</Fragment>
</Base>
