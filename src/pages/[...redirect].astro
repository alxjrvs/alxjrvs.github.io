---
// Old URLs, sent to the matching section of the home page with a real 301
// (a fragment can't go in Cloudflare's _redirects, where # starts a comment).
// Anything else unknown gets the 404 page.
const targets: Record<string, string> = {
  about: "/#about",
  projects: "/#projects",
  work: "/#projects",
  "work/boom": "/#projects",
  "work/dotfiles": "/#projects",
};
const key = (Astro.params.redirect ?? "").replace(/\/$/, "").toLowerCase();
// Ajar's old standalone reader (/ajarcomic/, /ajarcomic/3, /ajarcomic/end):
// one home now, the comic on the Writing page, at the same page.
const ajar = /^ajarcomic(?:\/(\d+|end)(?:\.html)?)?$/.exec(key);
if (ajar) {
  const n = Number(ajar[1]);
  return Astro.redirect(n > 1 ? `/writing/ajar/#page-${n}` : "/writing/ajar/", 301);
}
const target = targets[key];
if (target) return Astro.redirect(target, 301);
return Astro.rewrite("/404");
---
