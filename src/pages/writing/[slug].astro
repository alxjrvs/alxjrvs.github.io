---
import { decodeSlug } from "emdash";
import Prose from "../../components/Prose.astro";
import Tags from "../../components/Tags.astro";
import progressSrc from "../../client/progress.ts?inline-script";
import InlineScript from "../../components/InlineScript.astro";
import Base from "../../layouts/Base.astro";
import { getPosts, getProjects, longDate, readingMinutes, shortDate, year } from "../../lib/content";

// One piece of writing, rendered on request from the published posts in
// EmDash (newest first, so the next one along is older). Unknown or
// unpublished slugs get the 404. The details sit in the left-hand margin,
// the words in a 40rem column beside it.
const slug = decodeSlug(Astro.params.slug);
const posts = await getPosts(Astro);
const i = posts.findIndex((p) => p.id === slug);
const post = posts[i];
if (!post) return Astro.rewrite("/404");
const older = posts[i + 1];
const newer = posts[i - 1];
const proj = post.project
  ? (await getProjects(Astro)).find((p) => p.id === post.project)
  : undefined;
const minutes = readingMinutes(post.content);
const when = (d: Date) => `${shortDate(d)}, ${year(d)}`;
---
<Base title={post.title} description={post.description} published={post.date} progress>
<article class="post wrap ruled" style={proj && `--accent-light:${proj.accent};--accent-dark:${proj.accent_dark}`}>
  <aside class="margin post-margin">
    <a class="crumb label" href="/writing/"><span aria-hidden="true">←</span> Writing</a>
    <dl class="facts">
      <div><dt class="label">Published</dt><dd><time datetime={post.date.toISOString()}>{longDate(post.date)}</time></dd></div>
      <div><dt class="label">Reading</dt><dd>{minutes} min</dd></div>
      {proj && <div><dt class="label">Project</dt><dd><a class="tag" href={proj.link}>{proj.title} <span aria-hidden="true">↗</span></a></dd></div>}
      {post.tags.length > 0 && <div><dt class="label">Tags</dt><dd><Tags tags={post.tags} /></dd></div>}
    </dl>
  </aside>

  <div class="post-body" id="read">
    <header class="post-head">
      <h1>{post.title}</h1>
      {post.description && <p class="dek">{post.description}</p>}
    </header>

    <div class="prose">
      <Prose value={post.content} />
    </div>
    <p class="fin" aria-hidden="true"><span class="pip"></span></p>

    {(older || newer) && (
      <nav class="pager" aria-label="More writing">
        {newer ? (
          <a class="next" href={`/writing/${newer.id}/`}><span class="label"><span aria-hidden="true">←</span> Newer · {when(newer.date)}</span><span class="t">{newer.title}</span></a>
        ) : <span />}
        {older ? (
          <a class="prev" href={`/writing/${older.id}/`}><span class="label">Older · {when(older.date)} <span aria-hidden="true">→</span></span><span class="t">{older.title}</span></a>
        ) : <span />}
      </nav>
    )}
  </div>
</article>
<InlineScript slot="scripts" src={progressSrc} name="progress.ts" />
</Base>
