---
import PieceLines from "../../components/PieceLines.astro";
import Prose from "../../components/Prose.astro";
import Tags from "../../components/Tags.astro";
import ThreadLines from "../../components/ThreadLines.astro";
import Base from "../../layouts/Base.astro";
import {
  getPlaces,
  getPosts,
  getProjects,
  getSection,
  getTags,
  getThreads,
  longDate,
  measure,
  year,
} from "../../lib/content";

// The Writing index: every published piece in EmDash (Writing), newest first.
// The newest gets the big slot; the rest are ruled lines grouped by year, with
// the year in the left-hand margin, like a legal pad. Threads (chains of
// pieces that read together) get their own rows between the two.
const [posts, page, projects, tags, threads, places] = await Promise.all([
  getPosts(Astro),
  getSection(Astro, "writing-archive"),
  getProjects(Astro),
  getTags(Astro),
  getThreads(Astro),
  getPlaces(Astro),
]);
const [lead, ...rest] = posts;
const proj = lead && projects.find((p) => p.id === lead.project);
const leadPlace = lead && places.get(lead.id);
const oldest = posts.at(-1);
const count = `${posts.length} ${posts.length === 1 ? "piece" : "pieces"}`;
---
<Base title={page?.title ?? "Writing"} description={page?.dek}>
<div class="wrap">
<header class="pagehead writing-head">
  <div>
    {page?.kicker && <span class="label">{page.kicker}</span>}
    <h1>{page?.title}</h1>
  </div>
  {(page?.dek || lead) && (
    <div class="writing-aside">
      {page?.dek && <p class="dek">{page.dek}</p>}
      {lead && oldest && <p class="label">{count} · since {year(oldest.date)}</p>}
    </div>
  )}
</header>
{lead ? (
  <>
    <section class="ruled" aria-labelledby="latest">
      <h2 class="margin label" id="latest">Latest</h2>
      <div class="lead" style={proj && `--accent-light:${proj.accent};--accent-dark:${proj.accent_dark}`}>
        <p class="label meta">
          <time datetime={lead.date.toISOString()}>{longDate(lead.date)}</time>
          <span>{lead.pages.length ? measure(lead) : `${measure(lead)} read`}</span>
          {proj && <span class="tag">{proj.title}</span>}
          {leadPlace && <a class="thread-mark" href={`/writing/threads/${leadPlace.thread.slug}/`}>{leadPlace.thread.label} · Part {leadPlace.n} of {leadPlace.thread.parts.length}</a>}
        </p>
        <a class="lead-link" href={`/writing/${lead.id}/`}>
          <span class="t">{lead.title}</span>
          {lead.description && <span class="x">{lead.description}</span>}
          <span class="more">Read it <span aria-hidden="true">→</span></span>
        </a>
        <Tags tags={lead.tags} />
      </div>
    </section>
    <ThreadLines threads={threads} />
    <PieceLines posts={rest} projects={projects} places={places} />
    {tags.length > 0 && (
      <section class="ruled" aria-labelledby="all-tags">
        <h2 class="margin label" id="all-tags">Tags</h2>
        <div class="tag-cloud"><Tags tags={tags} /></div>
      </section>
    )}
  </>
) : (
  <div class="empty">{page && <Prose value={page.body} />}</div>
)}
</div>
</Base>
