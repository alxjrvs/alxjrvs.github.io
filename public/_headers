# Response headers for the static assets (Cloudflare Workers `_headers`).

# The workers.dev copy and PR previews are for checking deploys, not search.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# HTTPS only on the real site. One day to start (no subdomains, no preload)
# until the zone's DNS has been reviewed; pages get it from src/worker.ts.
https://alxjrvs.com/*
  Strict-Transport-Security: max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fonts and screenshots never change in place (a new one gets a new name or
# the CSS gets a new ?v=), so browsers can keep them a while.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# The stylesheet and favicon are linked with a per-build ?v=, so a copy never
# goes stale.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/assets/work/*
  Cache-Control: public, max-age=86400
