# Response headers for the static assets (Cloudflare Workers `_headers`).

# The workers.dev copy and PR previews are for checking deploys, not search.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# HTTPS only on the real site: thirty days, this host only (no subdomains, no
# preload). Pages get the same from src/worker.ts.
https://alxjrvs.com/*
  Strict-Transport-Security: max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fonts and screenshots never change in place (a new one gets a new name or
# the CSS gets a new ?v=), so browsers can keep them a while.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# The stylesheet and favicon are linked with a per-build ?v=, so a copy never
# goes stale.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/assets/work/*
  Cache-Control: public, max-age=86400
# The icons browsers and phones ask for by name (scripts/icons.mjs).
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
