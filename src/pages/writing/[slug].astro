---
import { decodeSlug } from "emdash";
import Prose from "../../components/Prose.astro";
import Base from "../../layouts/Base.astro";
import { getPosts, getProjects, longDate, readingMinutes } from "../../lib/content";

// Rendered on request from the published posts in EmDash (newest first, so
// the next one along is older). Unknown or unpublished slugs get the 404.
const slug = decodeSlug(Astro.params.slug);
const posts = await getPosts(Astro);
const i = posts.findIndex((p) => p.id === slug);
const post = posts[i];
if (!post) return Astro.rewrite("/404");
const older = posts[i + 1];
const newer = posts[i - 1];
const proj = post.project
  ? (await getProjects(Astro)).find((p) => p.id === post.project)
  : undefined;
---
<Base title={post.title} description={post.description} published={post.date}>
<article class="post wrap" style={proj && `--accent-light:${proj.accent};--accent-dark:${proj.accent_dark}`}>
  <header class="post-head">
    <a class="crumb label" href="/writing/">Writing</a>
    <h1>{post.title}</h1>
    {post.description && <p class="dek">{post.description}</p>}
    <p class="meta label">
      <span>{longDate(post.date)}</span>
      <span>{readingMinutes(post.content)} min read</span>
      {proj && <a href={proj.link}>On {proj.title} <span aria-hidden="true">↗</span></a>}
    </p>
  </header>

  <div class="prose">
    <Prose value={post.content} />
  </div>

  <nav class="pager" aria-label="More writing">
    {older && <a class="prev" href={`/writing/${older.id}/`}><span class="label">← Older</span><span class="t">{older.title}</span></a>}
    {newer && <a class="next" href={`/writing/${newer.id}/`}><span class="label">Newer →</span><span class="t">{newer.title}</span></a>}
  </nav>
</article>
</Base>
