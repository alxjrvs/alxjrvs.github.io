---
import ThreadLines from "../../../components/ThreadLines.astro";
import Base from "../../../layouts/Base.astro";
import { getThreads } from "../../../lib/content";

// The Threads index: every thread with a published part, newest activity
// first, ruled like the Writing index. With none yet it's the 404.
const threads = await getThreads(Astro);
if (threads.length === 0) return Astro.rewrite("/404");
const parts = threads.reduce((n, t) => n + t.parts.length, 0);
---
<Base title="Threads · Writing" description="Pieces of writing that read together, in order.">
<div class="wrap">
<header class="pagehead writing-head">
  <div>
    <a class="label crumb" href="/writing/"><span aria-hidden="true">←</span> Writing</a>
    <h1>Threads</h1>
  </div>
  <div class="writing-aside">
    <p class="label">{threads.length} {threads.length === 1 ? "thread" : "threads"} · {parts} {parts === 1 ? "part" : "parts"}</p>
  </div>
</header>
<ThreadLines threads={threads} heading="All" />
</div>
</Base>
