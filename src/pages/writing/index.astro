---
import Prose from "../../components/Prose.astro";
import Base from "../../layouts/Base.astro";
import {
  getPosts,
  getProjects,
  getSection,
  longDate,
  type Post,
  readingMinutes,
  shortDate,
  year,
} from "../../lib/content";

// The Writing index: every published piece in EmDash (Writing), newest first.
// The newest gets the big slot; the rest are ruled lines grouped by year, with
// the year in the left-hand margin, like a legal pad.
const [posts, page, projects] = await Promise.all([
  getPosts(Astro),
  getSection(Astro, "writing-archive"),
  getProjects(Astro),
]);
const project = (post: Post) => projects.find((p) => p.id === post.project);
const accent = (post: Post) => {
  const p = project(post);
  return p ? `--accent-light:${p.accent};--accent-dark:${p.accent_dark}` : undefined;
};
const [lead, ...rest] = posts;
const years = new Map<string, Post[]>();
for (const post of rest) {
  const y = year(post.date);
  years.set(y, [...(years.get(y) ?? []), post]);
}
const oldest = posts.at(-1);
const count = `${posts.length} ${posts.length === 1 ? "piece" : "pieces"}`;
---
<Base title={page?.title ?? "Writing"} description={page?.dek}>
<div class="wrap">
<header class="pagehead writing-head">
  <div>
    {page?.kicker && <span class="label">{page.kicker}</span>}
    <h1>{page?.title}</h1>
  </div>
  {(page?.dek || lead) && (
    <div class="writing-aside">
      {page?.dek && <p class="dek">{page.dek}</p>}
      {lead && oldest && <p class="label">{count} · since {year(oldest.date)}</p>}
    </div>
  )}
</header>
{lead ? (
  <>
    <section class="ruled" aria-labelledby="latest">
      <h2 class="margin label" id="latest">Latest</h2>
      <a class="lead" href={`/writing/${lead.id}/`} style={accent(lead)}>
        <p class="label meta">
          <time datetime={lead.date.toISOString()}>{longDate(lead.date)}</time>
          <span>{readingMinutes(lead.content)} min read</span>
          {project(lead) && <span class="tag">{project(lead)?.title}</span>}
        </p>
        <span class="t">{lead.title}</span>
        {lead.description && <span class="x">{lead.description}</span>}
        <span class="more">Read it <span aria-hidden="true">→</span></span>
      </a>
    </section>
    {[...years].map(([name, items]) => (
      <section class="ruled" aria-label={name}>
        <h2 class="margin year-mark">{name}</h2>
        <ul class="lines">
          {items.map((post) => (
            <li style={accent(post)}>
              <a href={`/writing/${post.id}/`}>
                <span class="body">
                  <span class="t">{post.title}</span>
                  {post.description && <span class="x">{post.description}</span>}
                  {project(post) && <span class="label tag">{project(post)?.title}</span>}
                </span>
                <span class="label when">
                  <time datetime={post.date.toISOString()}>{shortDate(post.date)}</time>
                  <span>{readingMinutes(post.content)} min</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </>
) : (
  <div class="empty">{page && <Prose value={page.body} />}</div>
)}
</div>
</Base>
