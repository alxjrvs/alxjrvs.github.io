---
import PostList from "../../components/PostList.astro";
import Prose from "../../components/Prose.astro";
import Base from "../../layouts/Base.astro";
import { getPosts, getSection, type Post, year } from "../../lib/content";

const [posts, page] = await Promise.all([getPosts(Astro), getSection(Astro, "writing-archive")]);
const years = new Map<string, Post[]>();
for (const post of posts) {
  const y = year(post.date);
  years.set(y, [...(years.get(y) ?? []), post]);
}
---
<Base title={page?.title ?? "Writing"} description={page?.dek}>
<div class="wrap">
<header class="pagehead">
  {page?.kicker && <span class="label">{page.kicker}</span>}
  <h1>{page?.title}</h1>
</header>
{posts.length > 0 ? (
  [...years].map(([name, items]) => (
    <section>
      <h2 class="year label">{name}</h2>
      <PostList posts={items} />
    </section>
  ))
) : (
  <div class="empty">{page && <Prose value={page.body} />}</div>
)}
</div>
</Base>
