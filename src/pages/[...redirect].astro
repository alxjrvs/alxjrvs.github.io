---
// Old URLs, sent to the matching section of the home page with a real 301
// (a fragment can't go in Cloudflare's _redirects, where # starts a comment).
// Anything else unknown gets the 404 page.
const targets: Record<string, string> = {
  about: "/#about",
  projects: "/#projects",
  work: "/#projects",
  "work/boom": "/#projects",
  "work/dotfiles": "/#projects",
};
const target = targets[(Astro.params.redirect ?? "").replace(/\/$/, "").toLowerCase()];
if (target) return Astro.redirect(target, 301);
return Astro.rewrite("/404");
---
